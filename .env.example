NUXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
NUXT_PUBLIC_HERE_API_KEY=your_here_api_key_here

# Public site URL for Open Graph and share links (no trailing slash). Use your production domain in deploy.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: default OG image path (e.g. /og-default.png) or full HTTPS URL
# NUXT_PUBLIC_OG_IMAGE_DEFAULT=
